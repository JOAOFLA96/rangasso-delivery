# Copie para .env e ajuste. NUNCA versionar o .env com valores reais.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://rangasso:TROQUE_A_SENHA@localhost:5432/rangasso_dev
PUBLIC_URL=http://localhost:3000
STORE_SLUG=rangasso
UPLOAD_DIR=./data/uploads
WEB_DIST_DIR=../web/dist
SESSION_TTL_HOURS=12
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
# true quando estiver atrás do Caddy/Nginx
TRUST_PROXY=false
LOG_LEVEL=info
