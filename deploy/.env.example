# Copie para deploy/.env no servidor. Nunca versione o .env com valores reais.
# Domínio apontado (registro A/AAAA) para o IP do servidor, ex.: pedidos.rangasso.com.br
DOMAIN=
# E-mail para o certificado HTTPS (Let's Encrypt)
ACME_EMAIL=
# Senha do banco: gere com  openssl rand -hex 24
DB_PASSWORD=
# Segredo do hash de IP: gere com  openssl rand -hex 32
IP_HASH_SECRET=
STORE_SLUG=rangasso
SESSION_TTL_HOURS=12
LOG_LEVEL=info
